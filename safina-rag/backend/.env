# ============ CHANGED: Added LLM Provider Selection ============
# LLM Provider: "ollama" or "poe"
LLM_PROVIDER=ollama
# ================================================================

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Ollama Configuration (used when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ============ CHANGED: Added Poe Configuration ============
# Poe Configuration (used when LLM_PROVIDER=poe)
# Get your API key from: https://poe.com/api_key
POE_API_KEY=EsSlCYPNrd071kErt9lmeb3Tb6lfxYJN7mSiIDNOHJ8
# Available models: Claude-Opus-4.1, Claude-Sonnet-4.5, GPT-5, Grok-4, etc.
POE_MODEL=Claude-Opus-4.1
# ===========================================================

# Cache Configuration
CUSTOMER_CACHE_TTL=86400
QUERY_CACHE_TTL=1800

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000